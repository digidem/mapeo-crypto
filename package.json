{
  "name": "@mapeo/crypto",
  "version": "1.1.0",
  "description": "Key management and encryption / decryption functions for Mapeo",
  "type": "module",
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "lint": "eslint --cache .",
    "format": "prettier . --write",
    "build": "tsc -p tsconfig.npm.json",
    "test": "prettier --check . && npm run lint && npm run type && node --test tests/*.test.js",
    "type": "tsc",
    "docs": "documentation readme src/index.js --section=API --infer-private '^(#|_)'",
    "prepublishOnly": "npm test",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "Digital Democracy",
  "license": "MIT",
  "dependencies": {
    "base32.js": "^0.1.0",
    "compact-encoding": "^3.3.1",
    "crc": "^4.3.2",
    "sodium-universal": "^5.0.1",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@digidem/types": "^2.4.1",
    "@eslint/js": "^10.0.1",
    "@types/compact-encoding": "^2.15.0",
    "@types/node": "^26.2.0",
    "@types/sodium-native": "^2.3.9",
    "documentation": "^14.0.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "hypercore": "^11.35.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "lint-staged": {
    "*.js": [
      "eslint --cache"
    ],
    "*": [
      "prettier --check"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digidem/mapeo-crypto.git"
  },
  "bugs": {
    "url": "https://github.com/digidem/mapeo-crypto/issues"
  },
  "homepage": "https://github.com/digidem/mapeo-crypto#readme"
}
